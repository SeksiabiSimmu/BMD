{
  "manifest_version": 3,
  "name": "Brave Music Downloader",
  "version": "2.6.0",
  "description": "Native messaging-powered music download queue with a choice of WAV, FLAC or MP3, embedded metadata and artwork, and a dashboard, for authorized YouTube content.",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "contextMenus",
    "notifications",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtube.com/*",
    "https://youtu.be/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "queue-current-wav": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Queue the current YouTube track"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Brave Music Downloader",
    "default_popup": "popup.html"
  },
  "options_page": "dashboard.html",
  "key": ""
}
